# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilitate cu proiecte Supabase care încă afișează cheia ca anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Project Settings > API; folosește doar server-side, nu în browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Project Settings > Database > Connection string.
# Pentru Prisma local/migrări folosește conexiunea directă PostgreSQL.
DATABASE_URL=

# Opțional: folosit de Prisma pentru shadow database dacă proiectul o cere.
SHADOW_DATABASE_URL=

# URL-ul aplicației folosit pentru metadata și redirect-uri.
NEXT_PUBLIC_APP_URL=http://localhost:3000
